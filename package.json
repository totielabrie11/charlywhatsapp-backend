{
  "name": "charlywhatsapp-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --max-old-space-size=${RENDER_MAX_OLD_SPACE_MB:-300} --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:push": "drizzle-kit push --config ./packages/db/drizzle.config.ts",
    "db:push-force": "drizzle-kit push --force --config ./packages/db/drizzle.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@clerk/express": "^2.1.41",
    "@clerk/shared": "^4.25.3",
    "@google/generative-ai": "^0.24.1",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "@workspace/api-zod": "file:./packages/api-zod",
    "@workspace/db": "file:./packages/db",
    "cookie-parser": "^1.4.7",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "googleapis": "^173.0.0",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^4.2.0",
    "mammoth": "^1.12.0",
    "openai": "^6.45.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "protobufjs": "^8.6.5",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "4.22.4",
    "typescript": "~5.9.3"
  }
}
