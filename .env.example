# ──────────────────────────────────────────────────────────────────────────
# CharlyWhatsapp backend — environment variables
# Copy this file to .env and fill in real values before running `pnpm dev`.
# ──────────────────────────────────────────────────────────────────────────

# Server -----------------------------------------------------------------
# Port the Express + Socket.IO server listens on. Render sets this
# automatically — do not hardcode a value in Render's dashboard, let Render
# inject its own PORT.
PORT=5000

# development | production. Set to "production" on Render.
NODE_ENV=development

# Public URL of this backend itself (used to build the Google OAuth
# redirect target for signed media links, etc.).
APP_URL=http://localhost:5000

# Public URL of the FRONTEND — a separate deployment (Vercel) on a
# different domain than this backend (Render). Used ONLY for things that
# send the user's browser somewhere: the redirect after the Google
# Calendar OAuth callback, and the deep-link inside synced Calendar events.
# Never guessed/hardcoded — if unset, those specific features fail loudly
# instead of redirecting to the wrong domain.
#   Local dev:  http://localhost:5173
#   Production: https://charlywhatsapp-frontend.vercel.app
FRONTEND_URL=http://localhost:5173

# Secret used to sign short-lived "copiar enlace" media links (15 min TTL).
# Falls back to CLERK_SECRET_KEY if unset (keeps working without extra
# config), but a dedicated secret is better hygiene — set your own random
# string in production.
MEDIA_LINK_SECRET=

# CORS ---------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call this API with
# credentials (Authorization header). No trailing slashes.
#   Local dev:  not required — localhost/127.0.0.1 are always allowed
#               automatically when NODE_ENV != production.
#   Production: REQUIRED. Example:
#     ALLOWED_ORIGINS=https://my-app.vercel.app,https://my-custom-domain.com
# If unset in production, the API currently fails open (allows all origins)
# and logs a warning — fix this before going live with real user data.
ALLOWED_ORIGINS=

# Database -----------------------------------------------------------------
# Postgres connection string used by @workspace/db (drizzle-orm). Use
# Supabase's pooled connection string (port 6543, "Transaction" mode) for
# a server that opens many short-lived connections like this one.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-1-us-west-2.pooler.supabase.com:6543/postgres

# Auth (Clerk) ---------------------------------------------------------------
# From your Clerk dashboard → API Keys. Must match the keys used by the
# frontend's VITE_CLERK_PUBLISHABLE_KEY for the same Clerk instance.
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Google (Calendar sync + Google Contacts import) ---------------------------
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxx
# Must exactly match a redirect URI registered in the Google Cloud Console —
# on Render this is https://charlywhatsapp-backend.onrender.com/api/calendar/auth/callback
GOOGLE_REDIRECT_URI=

# AI providers ---------------------------------------------------------------
# GROQ is used for fast/cheap inference in a few flows; Anthropic/OpenAI/Google
# Generative AI keys for the main "AI assistant" providers are configured at
# runtime per-workspace via the /api/ai-provider settings UI and stored in the
# database — they do NOT need to be set here. GROQ_API_KEY is the one provider
# key still read directly from the environment.
GROQ_API_KEY=

# WhatsApp (Baileys) session persistence -------------------------------------
# Local folder where WhatsApp (Baileys) auth/session state is written.
# Defaults to "./.wa_auth" relative to the backend folder if not set.
# NOTE: Render's filesystem is ephemeral on every deploy/restart — this
# session will be lost on redeploy unless you attach a Render persistent
# Disk mounted at this path (see the deployment report for details).
WA_AUTH_DIR=./.wa_auth

# Misc / ops -------------------------------------------------------------
# Comma-separated list of extra hostnames allowed to hit this API
# (only relevant if you deploy behind Replit-style domain routing —
# not used by the Render deployment).
REPLIT_DOMAINS=

# Shared secret required by internal/admin-only maintenance endpoints
# (e.g. POST /api/system/reset). Not a Clerk-authenticated route.
ADMIN_API_KEY=change-me

# pino log level: trace | debug | info | warn | error | silent
LOG_LEVEL=info

# Verbose WhatsApp (Baileys) debug logging: "1" to enable.
DEBUG_WA=

# ──────────────────────────────────────────────────────────────────────────
# System requirements (not env vars, but required on the host machine):
#   - ffmpeg   (used to transcode WhatsApp voice notes)
#   - python3 with `pymupdf` installed (pip install pymupdf)
#               used by scripts/pdf_to_images.py for PDF text/image extraction
#   Render's default Node runtime does NOT include ffmpeg or python3 —
#   see the deployment report for how to add them (Dockerfile or a Render
#   build-time apt install).
# ──────────────────────────────────────────────────────────────────────────
